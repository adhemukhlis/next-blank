{
	"browserslist": [
		"> 0.5% in ID",
		"not dead",
		"not op_mini all",
		"baseline widely available"
	],
	"dependencies": {
		"next": "^16.3.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	},
	"devDependencies": {
		"@types/bun": "^1.3.14",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"typescript": "^7.0.2"
	},
	"name": "next-blank",
	"private": true,
	"scripts": {
		"build": "next build",
		"deps:reset": "rm -rf node_modules .next package-lock.json && npm install",
		"deps:show": "npm ls --depth=Infinity",
		"deps:upgrade": "npx npm-check-updates -u && npm install",
		"dev": "node server.js dev",
		"fix": "node ./dev/lint.js --config ./dev/eslint.config.mjs --fix .",
		"format": "npm run --prefix dev format",
		"lint": "node ./dev/lint.js --config ./dev/eslint.config.mjs .",
		"minify": "npm run --prefix dev minify",
		"postinstall": "npm install --prefix dev",
		"size": "du -k -d 1 . | sort -nr > size.txt",
		"start": "node server.js start",
		"typecheck": "next typegen && tsc --noEmit",
		"unused": "npx knip --no-exit-code 2>&1 | tail -n +2 > knip-report.txt",
		"next:info": "next info 2>&1 | tail -n +2 > info.txt"
	},
	"version": "0.1.0"
}
