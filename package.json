{
	"name": "next-blank",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"build": "next build",
		"deps:reset": "rm -rf node_modules .next pnpm-lock.yaml && pnpm install",
		"deps:show": "pnpm ls --depth=Infinity",
		"deps:upgrade": "pnpm update --latest && pnpm install",
		"dev": "node server.js dev",
		"fix": "biome check --fix .",
		"format": "biome format --write .",
		"lint": "biome check .",
		"maintain-loop": "corepack use pnpm@latest && rm -rf node_modules/ .next/ pnpm-lock.yaml && pnpm install && pnpm update -r --latest && pnpm dedupe && pnpm prune && pnpm store prune && pnpm typecheck && pnpm fix",
		"next:info": "next info 2>&1 | tail -n +2 > info.txt",
		"size": "du -k -d 1 . | sort -nr > size.txt",
		"start": "node server.js start",
		"typecheck": "next typegen && tsc --noEmit",
		"unused": "pnpm dlx knip --no-exit-code 2>&1 | tail -n +2 > knip-report.txt"
	},
	"browserslist": [
		"> 0.5% in ID",
		"not dead",
		"not op_mini all",
		"baseline widely available"
	],
	"dependencies": {
		"next": "^16.4.3",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.3",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"typescript": "^7.0.2"
	},
	"packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
