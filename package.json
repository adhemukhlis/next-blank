{
	"browserslist": [
		"> 0.5% in ID",
		"not dead",
		"not op_mini all",
		"baseline widely available"
	],
	"dependencies": {
		"next": "^16.3.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	},
	"devDependencies": {
		"@types/bun": "^1.3.14",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"typescript": "^7.0.2"
	},
	"name": "next-blank",
	"private": true,
	"scripts": {
		"build": "bunx --bun next build",
		"deps:reset": "rm -rf node_modules .next bun.lock && bun pm cache rm && bun install",
		"deps:show": "bun list --depth=Infinity",
		"deps:upgrade": "bun up --latest",
		"dev": "bun run server.js dev",
		"fix": "bun run ./dev/lint.js --config ./dev/eslint.config.mjs --fix .",
		"format": "bun run --cwd dev format",
		"lint": "bun run ./dev/lint.js --config ./dev/eslint.config.mjs .",
		"minify": "bun run --cwd dev minify",
		"postinstall": "bun install --cwd dev",
		"size": "du -k -d 1 . | sort -nr > size.txt",
		"start": "bun run server.js start",
		"typecheck": "tsc --noEmit",
		"unused": "bunx --bun knip --no-exit-code 2>&1 | tail -n +2 > knip-report.txt"
	},
	"version": "0.1.0"
}