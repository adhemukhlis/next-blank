{
	"name": "next-blank",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"build": "bun --bun next build",
		"deps:reset": "rm -rf node_modules .next bun.lock && bun install",
		"deps:show": "bun pm ls --depth=Infinity",
		"deps:upgrade": "bun update --latest",
		"dev": "bun server.js dev",
		"fix": "biome check --fix .",
		"format": "biome format --write .",
		"lint": "biome check .",
		"maintain-loop": "rm -rf node_modules/ .next/ bun.lock && bun install && bun update --latest && bun dedupe && bun prune &&  bun pm cache rm && bun typecheck && bun fix",
		"next:info": "next info 2>&1 | tail -n +2 > info.txt",
		"size": "du -k -d 1 . | sort -nr > size.txt",
		"start": "bun server.js start",
		"typecheck": "next typegen && tsc --noEmit",
		"unused": "bunx knip --no-exit-code 2>&1 | tail -n +2 > knip-report.txt"
	},
	"browserslist": [
		"> 0.5% in ID",
		"not dead",
		"not op_mini all",
		"baseline widely available"
	],
	"dependencies": {
		"next": "^16.4.3",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.3",
		"@types/bun": "^1.4.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"typescript": "^7.0.2"
	}
}
