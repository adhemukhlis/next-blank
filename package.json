{
	"browserslist": [
		"> 0.5% in ID",
		"not dead",
		"not op_mini all",
		"baseline widely available"
	],
	"dependencies": {
		"next": "^16.2.12",
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	},
	"devDependencies": {
		"@eslint-react/eslint-plugin": "^5.18.0",
		"@eslint/js": "^10.0.1",
		"@next/eslint-plugin-next": "^16.2.12",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/node": "^26.1.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"eslint": "^10.8.0",
		"eslint-plugin-perfectionist": "^5.10.0",
		"globals": "^17.7.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.65.0"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"name": "next-blank",
	"packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
	"private": true,
	"scripts": {
		"build": "next build",
		"deps:reset": "rm -rf node_modules .next pnpm-lock.yaml && pnpm store prune && pnpm install",
		"deps:show": "pnpm list --depth=Infinity",
		"deps:upgrade": "pnpm up --latest",
		"dev": "node server.js dev",
		"fix": "eslint --fix .",
		"format": "prettier --config .prettierrc --log-level silent --write \"**/*.{js,jsx,mjs,cjs,ts,tsx,css,scss,less,json,yml,yaml,md}\"",
		"lint": "eslint .",
		"minify": "prettier --config .minifyrc --log-level silent --write \"**/*.{js,jsx,mjs,cjs,ts,tsx,css,scss,less,json,yml,yaml,md}\"",
		"size": "du -k -d 1 . | sort -nr > size.txt",
		"start": "node server.js start",
		"typecheck": "tsc --noEmit",
		"unused": "pnpx knip --no-exit-code 2>&1 | tail -n +2 > knip-report.txt"
	},
	"version": "0.1.0"
}
