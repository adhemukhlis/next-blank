{
	"browserslist": [
		"> 0.5% in ID",
		"not dead",
		"not op_mini all",
		"baseline widely available"
	],
	"dependencies": {
		"next": "^16.3.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"typescript": "^7.0.2"
	},
	"name": "next-blank",
	"packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
	"private": true,
	"scripts": {
		"build": "next build",
		"deps:reset": "rm -rf node_modules .next pnpm-lock.yaml && pnpm install",
		"deps:show": "pnpm ls --depth=Infinity",
		"deps:upgrade": "pnpm dlx npm-check-updates -u && pnpm install",
		"dev": "node server.js dev",
		"fix": "node ./dev/lint.js --config ./dev/eslint.config.mjs --fix .",
		"format": "pnpm --prefix dev run format",
		"install:dev": "pnpm install --prefix dev",
		"lint": "node ./dev/lint.js --config ./dev/eslint.config.mjs .",
		"minify": "pnpm --prefix dev run minify",
		"next:info": "next info 2>&1 | tail -n +2 > info.txt",
		"size": "du -k -d 1 . | sort -nr > size.txt",
		"start": "node server.js start",
		"typecheck": "next typegen && tsc --noEmit",
		"unused": "pnpm dlx knip --no-exit-code 2>&1 | tail -n +2 > knip-report.txt"
	},
	"version": "0.1.0"
}