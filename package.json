{
	"name": "next-blank",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"build": "next build",
		"deps:reset": "rm -rf node_modules .next pnpm-lock.yaml && pnpm install",
		"deps:show": "pnpm ls --depth=Infinity",
		"deps:upgrade": "pnpm update --latest && pnpm install",
		"dev": "node server.js dev",
		"fix": "biome check --fix .",
		"format": "biome format --write .",
		"lint": "biome check .",
		"next:info": "next info 2>&1 | tail -n +2 > info.txt",
		"size": "du -k -d 1 . | sort -nr > size.txt",
		"start": "node server.js start",
		"typecheck": "next typegen && tsc --noEmit",
		"unused": "pnpm dlx knip --no-exit-code 2>&1 | tail -n +2 > knip-report.txt"
	},
	"browserslist": [
		"> 0.5% in ID",
		"not dead",
		"not op_mini all",
		"baseline widely available"
	],
	"dependencies": {
		"next": "^16.3.6",
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@types/node": "^26.6.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"typescript": "^7.0.2"
	},
	"packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec"
}
