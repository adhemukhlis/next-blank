{
	"author": "adhemukhlis",
	"description": "Dev",
	"devDependencies": {
		"@eslint-react/eslint-plugin": "^5.18.1",
		"@eslint/js": "^10.0.1",
		"@next/eslint-plugin-next": "^16.3.0",
		"@stylistic/eslint-plugin": "^5.10.0",
		"eslint": "^10.8.0",
		"eslint-plugin-perfectionist": "^5.10.1",
		"globals": "^17.9.0",
		"prettier": "^3.9.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.66.0"
	},
	"name": "dev",
	"scripts": {
		"fix": "bunx --bun eslint --config ./eslint.config.mjs --fix",
		"format": "bunx --bun prettier --config ../.prettierrc --ignore-path ../.prettierignore --log-level silent --write \"../**/*.{js,jsx,mjs,cjs,ts,tsx,css,scss,less,json,yml,yaml,md}\"",
		"lint": "bunx --bun eslint --config ./eslint.config.mjs",
		"minify": "bunx --bun prettier --config ../.minifyrc --ignore-path ../.prettierignore --log-level silent --write \"../**/*.{js,jsx,mjs,cjs,ts,tsx,css,scss,less,json,yml,yaml,md}\""
	},
	"type": "module",
	"version": "1.0.0"
}